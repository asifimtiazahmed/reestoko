rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Helper Security Functions
    // =========================================================================

    /// Check if the incoming request is authenticated
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    /// Check if the request user is inspecting/editing their own user document
    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    /// Fetch household document data safely
    function getHouseholdData(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId)).data;
    }

    /// Verify user is an authorized member of the specified household
    function isHouseholdMember(householdId) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/households/$(householdId)) &&
             (request.auth.uid in getHouseholdData(householdId).memberUids);
    }

    /// Verify string field is non-empty and within character limits
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    /// Verify positive integer value
    function isPositiveInt(val) {
      return val is int && val >= 0;
    }

    // =========================================================================
    // 1. Users Collection (/users/{userId})
    // =========================================================================
    match /users/{userId} {
      // Any authenticated user can read profile info (for household member avatars)
      allow read: if isAuthenticated();

      // Users can only create their own user document
      allow create: if isSelf(userId)
                    && isValidString(request.resource.data.name, 1, 100)
                    && isValidString(request.resource.data.email, 3, 150)
                    && request.resource.data.isPremium is bool;

      // Users can update their profile, but CANNOT self-assign isPremium tier or change user id
      allow update: if isSelf(userId)
                    && request.resource.data.id == resource.data.id
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.isPremium == resource.data.isPremium
                    && isValidString(request.resource.data.name, 1, 100);

      // Prevent deletion of user records directly from client SDK
      allow delete: if false;
    }

    // =========================================================================
    // 2. Households Collection (/households/{householdId})
    // =========================================================================
    match /households/{householdId} {
      // Only authorized household members can read household document
      allow read: if isHouseholdMember(householdId);

      // Any authenticated user can create a household, setting themselves as owner & member
      allow create: if isAuthenticated()
                    && isValidString(request.resource.data.name, 1, 100)
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.memberUids is list
                    && request.auth.uid in request.resource.data.memberUids;

      // Household members can update household name, but cannot tamper with ownerUid or remove owner from memberUids
      allow update: if isHouseholdMember(householdId)
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && resource.data.ownerUid in request.resource.data.memberUids
                    && isValidString(request.resource.data.name, 1, 100);

      // Only the household owner can delete the household
      allow delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;

      // -----------------------------------------------------------------------
      // 2a. Storage Zones Subcollection (/households/{householdId}/zones/{zoneId})
      // -----------------------------------------------------------------------
      match /zones/{zoneId} {
        allow read: if isHouseholdMember(householdId);
        
        allow create: if isHouseholdMember(householdId)
                      && isValidString(request.resource.data.name, 1, 50)
                      && isValidString(request.resource.data.iconName, 1, 50);

        allow update: if isHouseholdMember(householdId)
                      && isValidString(request.resource.data.name, 1, 50)
                      && isValidString(request.resource.data.iconName, 1, 50);

        allow delete: if isHouseholdMember(householdId);
      }

      // -----------------------------------------------------------------------
      // 2b. Inventory Items Subcollection (/households/{householdId}/items/{itemId})
      // -----------------------------------------------------------------------
      match /items/{itemId} {
        allow read: if isHouseholdMember(householdId);

        allow create: if isHouseholdMember(householdId)
                      && isValidString(request.resource.data.name, 1, 150)
                      && isValidString(request.resource.data.zoneId, 1, 100)
                      && isPositiveInt(request.resource.data.quantity)
                      && isPositiveInt(request.resource.data.minThreshold)
                      && isValidString(request.resource.data.unit, 1, 30)
                      && request.resource.data.createdBy == request.auth.uid;

        // Prevent update bypass: immutable createdBy, strict type limits
        allow update: if isHouseholdMember(householdId)
                      && request.resource.data.createdBy == resource.data.createdBy
                      && isValidString(request.resource.data.name, 1, 150)
                      && isValidString(request.resource.data.zoneId, 1, 100)
                      && isPositiveInt(request.resource.data.quantity)
                      && isPositiveInt(request.resource.data.minThreshold)
                      && isValidString(request.resource.data.unit, 1, 30);

        allow delete: if isHouseholdMember(householdId);
      }

      // -----------------------------------------------------------------------
      // 2c. Shopping List Subcollection (/households/{householdId}/shopping_list/{shoppingItemId})
      // -----------------------------------------------------------------------
      match /shopping_list/{shoppingItemId} {
        allow read: if isHouseholdMember(householdId);

        allow create: if isHouseholdMember(householdId)
                      && isValidString(request.resource.data.name, 1, 150)
                      && isPositiveInt(request.resource.data.quantityToBuy)
                      && request.resource.data.quantityToBuy >= 1
                      && request.resource.data.isPurchased is bool
                      && request.resource.data.addedBy == request.auth.uid;

        allow update: if isHouseholdMember(householdId)
                      && request.resource.data.addedBy == resource.data.addedBy
                      && isValidString(request.resource.data.name, 1, 150)
                      && isPositiveInt(request.resource.data.quantityToBuy)
                      && request.resource.data.isPurchased is bool;

        allow delete: if isHouseholdMember(householdId);
      }

      // -----------------------------------------------------------------------
      // 2d. Activity Logs Subcollection (/households/{householdId}/activity_logs/{logId})
      // -----------------------------------------------------------------------
      match /activity_logs/{logId} {
        allow read: if isHouseholdMember(householdId);
        
        // Members can append logs, but logs are IMMUTABLE (no updates or deletes allowed!)
        allow create: if isHouseholdMember(householdId)
                      && isValidString(request.resource.data.action, 1, 50)
                      && request.resource.data.performedBy == request.auth.uid;

        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
